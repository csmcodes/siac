<?xml version="1.0" encoding="utf-8"?>
<!--
  Fuerza a los navegadores a revalidar los .js de esta carpeta en cada carga (sin descargarlos de nuevo si no
  cambiaron, gracias a Last-Modified/ETag) en vez de servirlos indefinidamente desde cache. Sin esto, un deploy
  puede quedar "a medias" para usuarios con el JS viejo cacheado - bug real detectado 2026-08-31 (Placa SRI
  guardando vacio porque el navegador seguia usando ComprobanteCOMY.js de antes del deploy).
-->
<configuration>
  <system.webServer>
    <staticContent>
      <clientCache cacheControlMode="DisableCache" />
    </staticContent>
  </system.webServer>
</configuration>
