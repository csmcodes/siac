<?xml version="1.0" encoding="utf-8"?>
<!--
  Mismo fix que WebUI/js/web.config, aplicado a CSS - evita que un deploy quede "a medias" por estilos
  cacheados en el navegador.
-->
<configuration>
  <system.webServer>
    <staticContent>
      <clientCache cacheControlMode="DisableCache" />
    </staticContent>
  </system.webServer>
</configuration>
